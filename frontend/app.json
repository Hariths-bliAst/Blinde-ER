{
  "expo": {
    "name": "Blind-ER",
    "slug": "blind-er",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Blind-ER needs camera access to scan book pages and read them aloud as an audiobook."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blinder.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Blind-ER uses the camera to scan physical book pages and narrate them aloud."
      }
    },
    "android": {
      "package": "com.blinder.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    }
  }
}
