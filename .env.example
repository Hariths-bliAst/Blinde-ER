# =============================================================================
# Blind-ER Environment Template (Safe to Commit - Copy to .env and fill values)
# =============================================================================

# Gemini LLM API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# FastAPI Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEFAULT_TARGET_LANGUAGE=English

# CRNN Model Weights Path (For Hariths when swapping mock CRNN with trained weights)
CRNN_MODEL_WEIGHTS_PATH=./models/crnn_book_scanner.pth
USE_MOCK_CRNN=true

# React Native / Expo Public Endpoint (Use your LAN IP for physical devices)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

